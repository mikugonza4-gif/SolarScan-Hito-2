      "id": "0129379f-03b2-4bc2-8a13-95ede0255551",
      "name": "Modelo 1 · Imágenes (EfficientNet-B0)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        160
      ],
      "retryOnFail": true,
