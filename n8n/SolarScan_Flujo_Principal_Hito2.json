    {
      "parameters": {
        "jsCode": "// Junta la rama con aprobación y la rama sin aprobación en un solo registro final.\nlet fila;\ntry { fila = $('Registrar decisión del supervisor').first().json; } catch (e) { fila = null; }\nif (!fila) fila = $('Validar salida y preparar registro').first().json;\nconst estado = fila.estado_aprobacion;\nconst encabezado = estado === 'APROBADA' ? `ORDEN DE TRABAJO ${fila.ot_id} APROBADA`\n  : estado === 'RECHAZADA' ? 'Orden de trabajo RECHAZADA por el supervisor'\n  : estado === 'SIN RESPUESTA' ? 'Orden de trabajo SIN APROBAR (sin respuesta en 2 horas)'\n  : 'Seguimiento: no requiere orden de trabajo';\nconst asunto = `[SolarScan][${fila.prioridad}] ${fila.accion} · ${fila.inversor} · ${encabezado.split(' (')[0]}`;\nconst texto = `SOLARSCAN · RESULTADO FINAL\\n${encabezado}\\n\\n${fila.mensaje}\\n\\nTablero: https://solarscan-zuqf.onrender.com/tablero`;\nreturn [{ json: { ...fila, asunto, texto_final: texto } }];"
      },
