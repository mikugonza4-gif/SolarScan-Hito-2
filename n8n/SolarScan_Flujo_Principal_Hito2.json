      "id": "ed448eb4-9aff-469a-af3e-ca867a42c55f",
      "name": "Formulario de inspección",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        300
      ],
      "webhookId": "a9654b5e-4681-4cb5-be1e-df4e412ab771"
    },
    {
      "parameters": {
        "jsCode": "// Valida el formulario, crea el identificador de la inspección y deja la foto con un nombre fijo.\nconst item = $input.first();\nconst j = item.json;\nconst claves = Object.keys(item.binary || {});\nif (claves.length !== 1) throw new Error('Se esperaba exactamente una foto.');\nconst inversor = String(j['Inversor'] || '').trim();\nconst fecha = String(j['Fecha de operación'] || '').trim();\nconst inspector = String(j['Código del inspector'] || '').trim().toUpperCase().slice(0, 20);\nif (!/^INV-\\d{2}$/.test(inversor)) throw new Error('Inversor inválido.');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(fecha)) throw new Error('Fecha inválida.');\nif (!/^[A-Z0-9-]{2,20}$/.test(inspector)) throw new Error('Use un código de inspector, no un nombre.');\nconst inspeccion_id = 'SS-' + $execution.id + '-' + Date.now().toString(36);\nreturn [{ json: { inspeccion_id, inversor, fecha, inspector, recibido_utc: new Date().toISOString() },\n          binary: { foto: item.binary[claves[0]] } }];"
      },
      "id": "ab66e4e8-e48f-46e9-9333-5d9195d35b15",
      "name": "Preparar inspección",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
