    {
      "parameters": {
        "jsCode": "// Lee la respuesta del supervisor. Si no respondió en 2 horas, la orden queda sin aprobar.\nconst fila = $('Validar salida y preparar registro').first().json;\nconst aprobado = $json.data && $json.data.approved === true;\nconst sinRespuesta = !$json.data;\nconst ot_id = aprobado ? 'OT-' + fila.inspeccion_id.replace('SS-', '') : '';\nreturn [{ json: { ...fila, estado_aprobacion: aprobado ? 'APROBADA' : (sinRespuesta ? 'SIN RESPUESTA' : 'RECHAZADA'), ot_id } }];"
      },
