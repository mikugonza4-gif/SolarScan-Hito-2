      "parameters": {
        "jsCode": "// Se ejecuta si un modelo o el LLM falla después de 3 intentos: avisa sin perder la inspección.\nlet p = {};\ntry { p = $('Preparar inspección').first().json; } catch (e) {}\nconst detalle = JSON.stringify($json.error || $json).slice(0, 400);\nconst texto = `SOLARSCAN · FALLA DE SERVICIO\\nInspección ${p.inspeccion_id || 's/i'} (${p.inversor || ''} ${p.fecha || ''}) no se pudo completar.\\n` +\n  `Un servicio no respondió después de 3 intentos. La foto debe revisarse manualmente.\\nDetalle técnico: ${detalle}`;\nreturn [{ json: { asunto: `[SolarScan][FALLA] Inspección ${p.inspeccion_id || ''} sin completar`, texto } }];"
      },
