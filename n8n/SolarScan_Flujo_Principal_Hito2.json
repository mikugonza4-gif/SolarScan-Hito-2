        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "inversor",
              "value": "={{ $('Preparar inspección').first().json.inversor }}"
            },
            {
              "name": "fecha",
              "value": "={{ $('Preparar inspección').first().json.fecha }}"
            }
          ]
        }
      },
      "id": "7020206f-3305-4bf4-ab7e-8e69794f61af",
      "name": "Modelo 2 · Serie temporal (regresión + LSTM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        160
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Consulta en lenguaje natural para el buscador semántico, a partir de las salidas de los modelos 1 y 2.\nconst img = $('Modelo 1 · Imágenes (EfficientNet-B0)').first().json;\nconst serie = $('Modelo 2 · Serie temporal (regresión + LSTM)').first().json;\nconst nombres = {'Bird-drop': 'excrementos de aves', 'Clean': 'panel limpio', 'Dusty': 'polvo acumulado',\n  'Electrical-damage': 'posible daño eléctrico, punto caliente', 'Physical-Damage': 'vidrio o marco dañado',\n  'Snow-Covered': 'nieve sobre los módulos'};\nlet q = `Panel fotovoltaico con ${nombres[img.clase] || img.clase}.`;\nif (serie.datos_suficientes && serie.anomalia) {\n  q += ` El inversor genera menos energía de la esperada (bajo rendimiento) durante ${serie.dias_consecutivos_bajo_umbral} día(s).`;\n}\nq += ' ¿Qué procedimiento de mantenimiento, limpieza o inspección corresponde?';\nreturn [{ json: { consulta: q, clase: img.clase, anomalia: Boolean(serie.anomalia), k: 3 } }];"
      },
      "id": "0c8aee91-084d-403c-979d-58e09b03ef6c",
      "name": "Armar consulta al manual",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://solarscan-zuqf.onrender.com/rag/buscar",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "2b85ec30-d42c-4695-ba22-02dc5bb9cc10",
      "name": "Modelo 3 · Manual O&M (embeddings / RAG)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        160
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Combina las salidas de los tres modelos en un solo objeto. El LLM recibe resultados, no datos crudos.\nconst p = $('Preparar inspección').first().json;\nconst img = $('Modelo 1 · Imágenes (EfficientNet-B0)').first().json;\nconst serie = $('Modelo 2 · Serie temporal (regresión + LSTM)').first().json;\nconst rag = $json;\nreturn [{ json: {\n  inspeccion_id: p.inspeccion_id,\n  imagen: { clase: img.clase, confianza: img.confianza, revision_humana: img.revision_humana },\n  serie,\n  contexto: (rag.resultados || []).map(r => ({ id: r.id, cita: r.cita, pagina: r.pagina, texto: r.texto })),\n  metodo_rag: rag.metodo\n}}];"
      },
      "id": "d57c2e99-2a4b-459d-b695-97557c982199",
      "name": "Resumen único para el LLM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://solarscan-zuqf.onrender.com/recomendacion-integrada",
        "options": {
          "timeout": 120000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({inspeccion_id: $json.inspeccion_id, imagen: $json.imagen, serie: $json.serie, contexto: $json.contexto}) }}"
      },
      "id": "0ecc0535-bd67-48b2-91a7-6421a0472484",
      "name": "LLM · Recomendación integrada (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1660,
        160
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Revisa que el JSON del LLM tenga los campos exigidos y arma la fila del historial y los mensajes.\nconst r = $json;\nfor (const c of ['diagnostico', 'recomendacion', 'prioridad', 'justificacion', 'accion']) {\n  if (!r[c]) throw new Error('Falta el campo ' + c + ' en la recomendación');\n}\nif (!['ALTA', 'MEDIA', 'BAJA'].includes(r.prioridad)) throw new Error('Prioridad inválida');\nconst p = $('Preparar inspección').first().json;\nconst res = $('Resumen único para el LLM').first().json;\nconst s = res.serie || {};\nconst pct = v => (v === null || v === undefined) ? '' : (v * 100).toFixed(1).replace('.', ',') + ' %';\nconst fila = {\n  fecha_registro_utc: p.recibido_utc, inspeccion_id: p.inspeccion_id, inversor: p.inversor,\n  fecha_operacion: p.fecha, inspector: p.inspector,\n  clase_imagen: res.imagen.clase, confianza_imagen: Number(res.imagen.confianza.toFixed(4)),\n  revision_humana_imagen: res.imagen.revision_humana,\n  indice_rendimiento: s.indice_rendimiento ?? '', indice_lstm: s.indice_rendimiento_lstm ?? '',\n  anomalia_serie: s.anomalia ?? '', perdida_kwh: s.perdida_estimada_kwh ?? '',\n  dias_bajo_umbral: s.dias_consecutivos_bajo_umbral ?? '', metodo_rag: res.metodo_rag,\n  fuentes: (r.fuentes || []).join(' | '), accion: r.accion, prioridad: r.prioridad,\n  diagnostico: r.diagnostico, recomendacion: r.recomendacion, justificacion: r.justificacion,\n  generado_por: r.generado_por, controles_ok: Boolean(r.controles && r.controles.cifras_verificadas && r.controles.fuentes_verificadas),\n  requiere_aprobacion: r.requiere_aprobacion, estado_aprobacion: r.requiere_aprobacion ? 'PENDIENTE' : 'NO REQUIERE', ot_id: ''\n};\nconst pasos = (r.pasos || []).map((x, i) => `${i + 1}. ${x}`).join('\\n');\nconst cuerpo = [\n  `Inspección ${p.inspeccion_id} · ${p.inversor} · ${p.fecha}`,\n  `Foto: ${res.imagen.clase} (confianza ${pct(res.imagen.confianza)})`,\n  s.datos_suficientes ? `Generación: ${pct(s.indice_rendimiento)} de lo esperado; pérdida estimada ${s.perdida_estimada_kwh} kWh` : 'Generación: sin datos suficientes',\n  '', `PRIORIDAD: ${r.prioridad} · ACCIÓN: ${r.accion}`, '',\n  'DIAGNÓSTICO', r.diagnostico, '', 'RECOMENDACIÓN', r.recomendacion, pasos, '',\n  'JUSTIFICACIÓN', r.justificacion, '', 'FUENTES', (r.fuentes || []).join('\\n') || 'Sin fuentes del manual',\n  '', `Generado por: ${r.generado_por}. Controles de verificación: ${fila.controles_ok ? 'aprobados' : 'no aprobados (texto de respaldo)'}.`\n].join('\\n');\nreturn [{ json: { ...fila, mensaje: cuerpo, pasos } }];"
      },
